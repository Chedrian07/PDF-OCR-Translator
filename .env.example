# Unlimited-OCR-2 only. Copy to .env and uncomment values you need.
# OCR_DEVICE=auto
# auto: Apple Silicon MLX, CUDA SGLang, Metal, CPU.
# OCR_ENGINE=unlimited2
# MODEL_ID=baidu/Unlimited-OCR-2
# MODEL_REVISION=c14071b549f4fcab10909f3c4acc6a2edb366947
# OCR_DTYPE=auto
# OCR_MLX_QUANT_BITS=0
# OCR_CPU_THREADS=4
# PRELOAD_MODEL=1
# DATA_DIR=data
# FRONTEND_DIR=
# RENDER_DPI=200
# PAGES_PER_CHUNK=8
# MAX_LENGTH=32768
# MAX_PAGE_OUTPUT_CHARS=16384
# MAX_PAGE_OUTPUT_TOKENS=6144
# MAX_PAGES=200
# MAX_UPLOAD_MB=100
# PAGE_SEPARATOR=\n\n---\n\n
# OCR_FIDELITY_THRESHOLD=0.70
# OCR_FIDELITY_MAX_RETRY_RATIO=0.2
# JOB_TTL_DAYS=0
# ALLOWED_HOSTS=localhost,127.0.0.1
# BIND_HOST=127.0.0.1
# GPU_DEVICE=0
# HF_TOKEN=
# HF_HUB_CACHE=
# HF_HUB_OFFLINE=0
# OCR_CPU_MEM_LIMIT=24g
# OCR_CUDA_MEM_LIMIT=24g
# OCR_WEB_MEM_LIMIT=8g
# PYTORCH_ENABLE_MPS_FALLBACK=1
# CUDA_LAUNCH_BLOCKING=0

# CUDA: pinned official SGLang service, no quantization or resolution reduction.
# OCR_SIDECAR_URL=http://127.0.0.1:10000
# OCR_SIDECAR_CONNECT_TIMEOUT_S=10
# OCR_SIDECAR_READ_TIMEOUT_S=600
# OCR_SIDECAR_HEALTH_TIMEOUT_S=5
# OCR_SIDECAR_MAX_RESPONSE_MB=20
# OCR_SIDECAR_MODEL_WAIT_S=900
# SGLANG_MEM_FRACTION=0.65
# SGLANG_CONCURRENCY=1

# ── 한국어 번역 — OpenAI 호환 API (Chat Completions·Responses 둘 다 지원) ──
# 주의: 실 API 키는 .env에만 적는다 (.env는 git에 커밋되지 않음)
# base URL은 origin 또는 /v1 경로 모두 허용하며, origin만 적으면 /v1을 자동 보완
# (예: https://api.openai.com, https://api.openai.com/v1,
# http://localhost:1234, http://localhost:1234/v1)
# 아래 세 줄도 주석으로 둔다 — 활성 빈 줄은 위쪽에 붙여 넣은 값을 덮어써(마지막 줄이 이긴다)
# 번역이 '프로바이더 미설정'이 된다. docker compose는 빈 값을 따로 넘기므로 필요 없다.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# 선택 — 번역 세부 설정 (기본값이면 생략 가능)
# TRANSLATE_MODEL=
#   미설정 시 OPENAI_MODEL 사용
# TRANSLATE_API_MODE=auto
#   auto|chat|responses (auto: responses 시도 → 미지원 시 chat 폴백)
# TRANSLATE_CONCURRENCY=8
#   잡당 동시 번역 요청 수 (1–8, 기본 8)
# TRANSLATE_GLOBAL_CONCURRENCY=8
#   여러 잡을 합친 서버 프로세스 전체 HTTP 상한 (1–8)
#   생략 시 TRANSLATE_CONCURRENCY와 같은 값 사용
#   로컬 vLLM/Ollama 등 소형 서버나 429가 잦은
#   공급자는 두 값을 4 이하로 낮출 것
# TRANSLATE_TIMEOUT_S=180
#   응답 읽기 타임아웃(초); 연결은 min(10초, 이 값)
#   스트리밍(chat)에서는 '토큰 사이 정지 시간' 상한이고, 비스트리밍
#   (responses·TRANSLATE_STREAM=0)에서는 대기열+생성 전체 시간 상한이다
# TRANSLATE_STREAM=auto
#   auto|1|0 — auto는 chat 모드에서 SSE 스트리밍(서버가 거부하면 자동 비스트리밍).
#   스트리밍은 느린 로컬 생성도 끊지 않고, 취소 시 연결을 끊어 서버 생성까지 멈춘다
# TRANSLATE_MAX_RESPONSE_MB=32
#   번역 응답 본문 상한(MB, 1–1024) — 넘으면 읽기를 멈추고 오류
#   (고장·악성 게이트웨이의 무한 응답으로 메모리가 고갈되는 것을 막는다)
# TRANSLATE_MAX_RETRIES=3
#   연결 오류·408/429/500/502/503/504 재시도 횟수
# TRANSLATE_TEMPERATURE=0
#   "none"이면 temperature 파라미터 자체를 생략
# TRANSLATE_MAX_TOKENS_PARAM=max_tokens
#   max_tokens|max_completion_tokens|none
# TRANSLATE_REASONING=off
#   reasoning 모델용: off|low|medium|high|xhigh (빈 값=파라미터 미전송)
#   reasoning 모델(OpenRouter 등)은 off 권장 — 실측 22배 빠르고 비용 ~1/40
#   effort별 요청 max_tokens: off/미설정 8192 · low 10240 · medium 20480 · high 40960 · xhigh 81920
#   출력이 잘리면(finish_reason=length / incomplete) 예산 2배로 자동 1회 재시도
# TRANSLATE_REASONING_STYLE=auto
#   TRANSLATE_REASONING 값을 어떤 필드로 보낼지:
#   auto|openrouter|chat_template_kwargs|reasoning_effort|none
#   auto는 base URL로 고른다 — 루프백·사설 IP·단일 라벨·localhost·
#   *.localhost·*.local·*.lan·*.home.arpa·*.internal(host.docker.internal·
#   host.containers.internal 포함 — oMLX·LM Studio·mlx_lm.server·vLLM)은
#   chat_template_kwargs(off면 enable_thinking=false), openrouter.ai는
#   openrouter(reasoning.enabled/effort), api.openai.com·*.api.openai.com
#   (데이터 레지던시)은 reasoning_effort(off=none), 그 밖의 공개 호스트는
#   openrouter(종전 동작). OpenAI로 넘기는 *.internal 게이트웨이는 값을 명시한다
#   로컬 MLX 서버는 reasoning 필드를 무시한다 — off가 듣지 않으면
#   chat_template_kwargs를 명시하거나 서버에서 thinking을 끈다
#   (mlx_lm.server --chat-template-args '{"enable_thinking":false}')
# TRANSLATE_EXTRA_BODY=
#   모든 번역 요청 본문에 병합할 JSON 객체(서버 전용 파라미터)
#   예: {"repetition_penalty": 1.05} — 객체 값은 한 단계만 병합
#   model·messages·stream·max_tokens·store 등은 덮어쓸 수 없다
# TRANSLATE_CONTEXT=1
#   직전 유닛 꼬리를 문맥으로 제공 (0이면 비활성)

# ── 페이지 Q&A · LLM 공급자 (결과 화면의 '질문' 탭 — Localight 통합) ──
# 경고: Q&A는 번역용 OPENAI_API_KEY를 절대 재사용하지 않는다. 아래 요청은 항상
# 공식 https://api.openai.com 으로 나가므로, OpenRouter·로컬 vLLM 등 다른 공급자용
# 키를 넣으면 그 키가 무관한 제3자에게 전송된다.
# LLM_OPENAI_API_KEY=
#   Q&A 전용 OpenAI 키. 미설정이면 openai-* 공급자는
#   /api/providers에서 available:false로 광고된다(Ollama는 사용 가능)
# LLM_PROVIDER=openai-responses
#   openai-responses | openai-chat | ollama | local-openai — 기본 공급자
# LLM_REASONING_EFFORT=low
#   default|none|minimal|low|medium|high|xhigh|max — 기본 reasoning effort
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
#   공식 api.openai.com 호스트만 허용 (그 외 값은 기동 실패)
# LLM_OPENAI_RESPONSES_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
#   Responses 모델 선택지(csv)
# LLM_OPENAI_CHAT_MODELS=chat-latest,gpt-5.6-luna,gpt-5.6-terra
#   Chat Completions 모델 선택지(csv)
# LLM_OPENAI_RESPONSES_MODEL=gpt-5.6-luna
#   Responses 기본 모델
# LLM_OPENAI_CHAT_MODEL=chat-latest
#   Chat Completions 기본 모델
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#   로컬 Ollama 주소 — 루프백·host.docker.internal·ollama만
#   허용(그 외 기동 실패). compose 컨테이너 기본값은
#   http://host.docker.internal:11434 (호스트 Ollama)
# OLLAMA_MODEL=qwen3:8b
#   기본 로컬 Ollama 모델 (:cloud/remote_host 모델은 차단됨)
# OLLAMA_MEM_LIMIT=16g
#   (compose.ollama.yaml 오버레이) ollama 컨테이너 메모리 상한 — 큰 모델이면 올린다
# LLM_LOCAL_OPENAI_BASE_URL=
#   로컬 OpenAI 호환 서버(oMLX·LM Studio·mlx_lm.server)를 Q&A 공급자
#   local-openai로 쓴다. 빈 값 = 미사용(목록에 광고하지 않음).
#   루프백·host.docker.internal의 http(s)만 허용(그 외 기동 실패).
#   예: 네이티브 http://127.0.0.1:1235/v1 (oMLX) · :1234/v1 (LM Studio),
#   Docker는 http://host.docker.internal:1235/v1
# LLM_LOCAL_OPENAI_MODEL=
#   local-openai 기본 모델 — 서버 /v1/models의 id 그대로
#   (mlx_lm.server는 default_model). 주소를 두면 필수
# LLM_LOCAL_OPENAI_MODELS=
#   추가로 고를 수 있는 모델(csv) — 그 외 모델 요청은 400
# LLM_LOCAL_OPENAI_API_KEY=
#   서버에 키를 걸었을 때만. 번역용 OPENAI_API_KEY·LLM_OPENAI_API_KEY는
#   절대 재사용하지 않는다. thinking 끄기는 chat_template_kwargs로 보낸다

# ── 남용 방어 상한 (인증 없는 서비스의 비용 상한 — 초과분은 429 + Retry-After) ──
# 잡·IP 단위 슬라이딩 윈도우(1분)와 동시 실행 상한. 기본값은 1인 로컬 사용을
# 방해하지 않는 수준이다 — 여럿이 쓰는 서버에 노출했거나 유료 LLM 키를 쓰면 낮추고,
# 자동화 스크립트로 대량 처리한다면 올린다. 0 이하 = 해당 상한 비활성(권장하지 않음).
# QA_RATE_LIMIT_PER_MIN=30
#   페이지 Q&A 요청/분 — 유료 키 소진 방어
# QA_MAX_CONCURRENT=4
#   동시에 처리 중인 Q&A 수
# TRANSLATE_RATE_LIMIT_PER_MIN=12
#   번역 시작 요청/분 — 200페이지 번역 반복 트리거 방어
# TRANSLATE_MAX_ACTIVE=4
#   동시에 도는 번역 스레드 수(잡 단위)
#   ※ MAX_UPLOAD_MB는 업로드 본문 상한으로, 멀티파트
#     파싱 전에 강제된다(초과 본문은 디스크에 닿지 않음)
# TRUSTED_PROXY_HOPS=0
#   앞단 신뢰 프록시(리버스 프록시·LB) 홉 수. 기본 0은
#   X-Forwarded-For를 완전히 무시한다 — 헤더 위조로 위
#   상한을 우회할 수 없게 하는 안전한 기본값.
#   언제 바꾸나: nginx/Caddy/Cloudflare 뒤에 둘 때만.
#   0으로 두면 모든 사용자가 프록시 IP 한 버킷으로
#   붕괴해 한 명이 전체 레이트리밋을 소진한다.
#   값 = 앱 앞단 프록시 개수(단일 nginx면 1). 실제 값보다
#   크게 잡으면 클라이언트가 위조한 항목을 신뢰하게 된다.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
#   X-Forwarded-For를 믿을 직접 연결 피어(프록시)의 IP·CIDR
#   목록(콤마). TRUSTED_PROXY_HOPS가 0보다 클 때만 쓰인다.
#   비우면 루프백만 — 같은 호스트의 nginx/Caddy가 붙는 배치.
#   목록 밖 피어(백엔드 포트에 바로 붙은 LAN 클라이언트)의
#   헤더는 위조로 보고 무시한다(그 피어 IP로 레이트리밋).
#   IP가 아닌 피어(유닉스 소켓 등 로컬 전송)는 원격 클라이언트일
#   수 없으므로 목록과 무관하게 믿는다.
#   Docker: 호스트 프록시가 게시 포트로 붙으면 피어가 브리지
#   게이트웨이(예: 172.17.0.1)로 보인다 — 그 주소·대역을 넣는다.
#   프록시를 쓰면 BIND_HOST=127.0.0.1로 백엔드 포트도 닫을 것.

# ── 번역 PDF 내보내기 (GET /api/jobs/{id}/pdf?lang=ko) ──
# PDF_EXPORT_FONT=
#   Docker 기본은 이미지에 설치된 Noto CJK(설정 불필요).
#   사용자 폰트는 컨테이너 내부 절대경로(예: /fonts/custom.otf)를
#   쓰고 활성 backend 서비스에 read-only bind mount한다(README §내보내기).
#   네이티브 실행은 시스템 폰트 → PyMuPDF 내장 CJK 순으로 폴백한다.
# PDF_EXPORT_MAX_CONCURRENT=2
#   서로 다른 잡의 PDF 빌드·래스터 동시 실행 상한(서버 전역)이자
#   export 워커 프로세스 수. 빌드는 서버 밖의 워커 프로세스에서
#   돌아 N개가 실제로 병렬이다(예전 스레드 방식은 GIL 때문에
#   코어 하나를 나눠 썼다). 잡 단위 락은 같은 잡의 중복 빌드만 막는다.
#   언제 바꾸나: 코어가 많고 대기가 잦으면 올리고, OCR과 CPU를
#   나눠 쓰려면 1로 내린다(1이면 번역 직후 예열 빌드를 하지 않는다).
#   0 이하 = 슬롯 상한 비활성(워커는 최대 min(8, CPU)개).
# PDF_EXPORT_QUEUE_TIMEOUT_S=30
#   빌드 슬롯 대기 상한(초). 초과하면 매달리지 않고
#   503 + Retry-After로 거절한다(재시도하면 성공 가능).
#   언제 바꾸나: 페이지가 많아 한 건이 30초를 넘으면 올린다.
# PDF_EXPORT_WARM_WAIT_S=180
#   같은 잡의 예열 빌드가 도는 동안 들어온
#   사용자 클릭의 대기 상한(초). 그 기다림은
#   줄서기가 아니라 바로 그 PDF가 만들어지는
#   시간이라 일반 대기열 상한과 분리한다.

# ── PyMuPDF 격리 워커 · 업로드 복잡도 게이트 ──
# PDF 렌더·분석·내보내기는 서버 밖의 워커 프로세스에서 돈다(ocr 1개 ·
# export PDF_EXPORT_MAX_CONCURRENT개 · 업로드 검증 2개, 처음 쓸 때 기동).
# 악성·병적 PDF가 서버·OCR 워커를 멈추거나 OOM으로 함께 죽이지 못하게
# 작업마다 시간 상한을 두고, 넘기거나 죽은 워커만 정리한다.
# PDF_PAGE_TIMEOUT_S=60
#   페이지 한 장의 MuPDF 작업(입력 렌더·충실도 분석·텍스트 레이어
#   추출·facsimile 래스터) 상한(초). 넘긴 페이지는 흰 페이지(경고)로
#   대체하거나 그 페이지의 분석을 건너뛴다. 렌더 상한 초과가 한 잡에서
#   3번 쌓이면 잡을 끝낸다. 업로드 검증 한 건의 상한도 이 값이다.
#   언제 바꾸나: 아주 복잡한 도면·지도 페이지가 흰 페이지로 나오면
#   올린다. 0 이하 = 상한 없음(권장하지 않음 — 적대적 PDF가 워커를
#   무기한 붙잡는다).
# PDF_EXPORT_BUILD_TIMEOUT_S=900
#   번역·대조 PDF 빌드 한 건의 상한(초). 넘기면 그 다운로드는
#   409(사유 안내)이고 빌드 워커만 정리된다(실측 M4 Max 25쪽 논문
#   0.3–1.0s/쪽 — 번역문이 길수록 느리다).
#   언제 바꾸나: 수백 쪽 문서를 느린 CPU에서 내보내면 올린다.
#   0 이하 = 상한 없음.
# PDF_WORKER_MEM_LIMIT_MB=0
#   PDF 워커 프로세스당 가상 메모리 상한(MB, RLIMIT_AS — Linux만).
#   넘으면 그 작업만 메모리 오류로 실패한다(서버·다른 잡은 무사).
#   0 = 끄기. 끄더라도 Linux 워커는 oom_score_adj=1000이라 메모리
#   압박 시 커널이 서버 대신 워커를 먼저 정리한다. macOS는 커널이
#   RLIMIT_AS를 강제하지 않아 적용하지 않는다.
#   x86_64(amd64) 이미지를 에뮬레이션(Apple Silicon의 Rosetta 등)으로
#   돌릴 때는 켜지 마세요 — 에뮬레이터의 큰 가상 메모리 예약까지 세어
#   워커가 기동 직후 죽는다(업로드가 '서버 설정 문제' 500). Apple
#   Silicon에서는 arm64 이미지를 쓴다.
#   언제 바꾸나: 컨테이너 메모리 상한이 빠듯하면 그 절반쯤(예: 4096).
# PDF_MAX_PAGE_CONTENT_MB=64
#   업로드 게이트 — 페이지가 그리게 하는 콘텐츠(콘텐츠 스트림 +
#   도달하는 XObject·패턴·Type3 글리프, 압축 해제 기준)의 페이지당
#   상한(MB). 넘으면 업로드를 400으로 거부한다(평면 path 10^7개
#   페이지가 분석 한 번에 ~16GB를 요구해 서버째 OOM으로 죽었다).
#   정상 논문은 페이지당 1MB 미만. 0 = 검사 끄기.
# PDF_MAX_PAGE_XOBJECT_CALLS=2000000
#   업로드 게이트 — Form XObject 중첩을 펼친 페이지당 그리기 호출
#   상한. 수 KB짜리 파일이 중첩으로 10^12회를 그리게 해 렌더가 사실상
#   끝나지 않았다. 정상 문서는 수백 회, 10^6점 산점도도 10^6회다.
#   0 = 검사 끄기.
