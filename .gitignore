*.pfx
*.jks
credentials/
secrets/

# 커버리지·일회성 렌더/검증 파일
.coverage
coverage.xml
htmlcov/
tmp/

# smoke 테스트가 backend/에서 실행될 때 생기는 부산물
backend/sample/
