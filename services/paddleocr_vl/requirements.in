# PaddleOCR-VL sidecar 최상위 고정 — requirements.lock(전이 의존성·해시까지 고정한
# 실제 잠금)의 입력이다. 여기를 바꾸면 requirements.lock 머리말의 명령으로 다시 만든다.

# paddlepaddle-gpu: PyPI에는 2.6.2까지만 있고 cu129 빌드가 없다. 공식 cu129 인덱스가
# 가리키는 CDN 휠을 URL로 직접 고정한다 — 그 인덱스는 numpy·pillow·anyio 등도 미러로
# 서빙해서 추가 인덱스로 걸면 다른 패키지까지 출처가 섞인다(인덱스 혼동).
# 공식 NVIDIA Blackwell 가이드 최소 3.2.1, 3.3.1은 RTX 5070 Ti 실측 검증 버전이다.
paddlepaddle-gpu @ https://paddle-whl.cdn.bcebos.com/stable/cu129/paddlepaddle-gpu/paddlepaddle_gpu-3.3.1-cp312-cp312-linux_x86_64.whl
# paddleocr 3.6.x = PaddleOCR-VL-1.6 동봉 버전 (paddlex[ocr,genai-client]>=3.6,<3.7)
paddleocr[doc-parser]==3.6.0
# 웹 계층 — backend/uv.lock과 같은 버전으로 맞춘다(업로드·폼 파서 상한 동작을 서비스 간 일치)
fastapi==0.139.0
uvicorn==0.50.2
python-multipart==0.0.32
# revision 고정 스냅샷 다운로드에 직접 사용 (app/model.py::_pin_revision)
huggingface_hub==1.24.0

